rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all (Eight Pillars - Fortress Pattern)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive and Identity Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection validation endpoint (public get to verify backend reachability on initial app boot)
    match /test/connection {
      allow get: if true;
    }

    // Validation helper for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 254 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 64));
    }

    // Validation helper for UserAccessCode entity
    function isValidAccessCode(data, userId) {
      return data.keys().hasAll(['userId', 'accessToken', 'isValid']) &&
             data.userId == userId &&
             data.accessToken is string && data.accessToken.size() > 0 && data.accessToken.size() <= 4096 &&
             data.isValid is bool &&
             (!('expiresAt' in data) || data.expiresAt is number) &&
             (!('accessCode' in data) || (data.accessCode is string && data.accessCode.size() <= 4096)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 254)) &&
             (!('fyId' in data) || (data.fyId is string && data.fyId.size() <= 64)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 64)) &&
             (!('tokenType' in data) || (data.tokenType is string && data.tokenType.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Users collection - isolated per authenticated user
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                   incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt', 'lastLogin']);
      allow delete: if false;

      // Access Codes subcollection - securely stores Fyers access codes against each user
      match /access_codes/{codeId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(codeId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(codeId) && isValidAccessCode(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(codeId) && isValidAccessCode(incoming(), userId) &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['accessToken', 'accessCode', 'expiresAt', 'isValid', 'tokenType', 'fyId', 'source', 'updatedAt', 'userEmail', 'createdAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(codeId);
      }
    }
  }
}

